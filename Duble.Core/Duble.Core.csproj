<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Duble</RootNamespace>
    <AssemblyName>Duble.Core</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CodeWalker\CodeWalker.Core\CodeWalker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- slowniki PL/EN: powody werdyktow, nazwy werdyktow, rozpiska jakosci (Powody.cs / Teksty) -->
    <EmbeddedResource Include="i18n\pl.json" LogicalName="Duble.i18n.pl.json" />
    <EmbeddedResource Include="i18n\en.json" LogicalName="Duble.i18n.en.json" />
  </ItemGroup>
</Project>
