<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Duble.Core</RootNamespace>
    <AssemblyName>Duble.Core</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\external\CodeWalker\CodeWalker.Core\CodeWalker.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- slowniki PL/EN: powody werdyktow, nazwy werdyktow, rozpiska jakosci (Powody.cs / Teksty) -->
    <EmbeddedResource Include="i18n\pl.json" LogicalName="Duble.Core.i18n.pl.json" />
    <EmbeddedResource Include="i18n\en.json" LogicalName="Duble.Core.i18n.en.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>
</Project>
