<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Duble.App</RootNamespace>
    <AssemblyName>Duble</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\duble.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <ProjectReference Include="..\Duble.Core\Duble.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>
  <ItemGroup>
    <!-- The interface is embedded in the executable; in developer mode it is read from ui\ instead, so that
         editing an HTML, CSS or JS file is one page reload away from being visible. -->
    <EmbeddedResource Include="ui\**\*" Exclude="ui\_dev-*.js" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="assets\duble.ico" />
  </ItemGroup>
</Project>
