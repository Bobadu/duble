<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Duble.App</RootNamespace>
    <AssemblyName>Duble</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\duble.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- the entry point is written out in App.xaml.cs — Velopack's hooks must run before WPF wakes up -->
    <StartupObject>Duble.App.App</StartupObject>
  </PropertyGroup>

  <!-- App.xaml compiles as a page rather than the application definition, so it stops generating a Main -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <ProjectReference Include="..\Duble.Core\Duble.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\duble.ico" />
    <!-- About -> What's new shows the changelog of the build it ships in, so it rides inside the assembly -->
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <!--
    The interface is a React application in web\, built by Vite into web\dist\ and embedded here. Building it
    needs Node; CONTRIBUTING.md says so, and running `npm run dev` alongside the application in developer mode
    is the loop that avoids a rebuild for every edit.
  -->
  <ItemGroup>
    <InterfaceSource Include="web\src\**\*" />
    <InterfaceSource Include="web\index.html;web\package.json;web\package-lock.json;web\vite.config.ts;web\tsconfig.json" />
  </ItemGroup>

  <Target Name="BuildInterface" BeforeTargets="PrepareForBuild" Inputs="@(InterfaceSource)" Outputs="web\dist\index.html">
    <Exec Command="npm ci" WorkingDirectory="web" Condition="!Exists('web\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="web" />
  </Target>

  <!--
    Added inside a target rather than in a plain ItemGroup: the files do not exist until BuildInterface has run,
    and an ItemGroup at the top of the file is evaluated long before that.
  -->
  <Target Name="EmbedInterface" AfterTargets="BuildInterface" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <InterfaceBundle Include="web\dist\**\*" />
      <EmbeddedResource Include="@(InterfaceBundle)" LogicalName="ui/%(InterfaceBundle.RecursiveDir)%(InterfaceBundle.Filename)%(InterfaceBundle.Extension)" />
    </ItemGroup>
  </Target>
</Project>
