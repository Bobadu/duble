<Window x:Class="Duble.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Duble" Width="1280" Height="820" MinWidth="960" MinHeight="600" Icon="pack://application:,,,/assets/duble.ico"
        WindowStartupLocation="CenterScreen" Background="#1B1A1F"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Grid>
    <wv2:WebView2 x:Name="web" DefaultBackgroundColor="#1B1A1F" AllowExternalDrop="True" />
  </Grid>
</Window>
